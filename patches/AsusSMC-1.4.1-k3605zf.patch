+IOReturn AsusSMC::writeKBBN(uint8_t value) {
+    OSNumber *arg = OSNumber::withNumber(value, 8);
+    IOReturn ret = atkDevice->evaluateObject("SKBB", NULL, (OSObject **)&arg, 1);
+    arg->release();
+    setProperty("KBBLWriteRet", (unsigned long long)(uint32_t)ret, 32);
+    return ret;
+}
+
+void AsusSMC::stepKeyboardBacklight(int delta) {
+    uint32_t before = 0xFFFFFFFF;
+    atkDevice->evaluateInteger("GKBB", &before);
+
+    if (delta > 0) {
+        keyboardBacklightLevel = (keyboardBacklightLevel + 1) % kKBLevelCount;
+    } else {
+        keyboardBacklightLevel = (keyboardBacklightLevel + kKBLevelCount - 1) % kKBLevelCount;
+    }
+
+    IOReturn ret = writeKBBN(kKBLevels[keyboardBacklightLevel]);
+
+    uint32_t readback = 0xFFFFFFFF;
+    atkDevice->evaluateInteger("GKBB", &readback);
+    setProperty("KBLevel", (unsigned long long)keyboardBacklightLevel, 32);
+    setProperty("KBBNBefore", (unsigned long long)before, 32);
+    setProperty("KBBNAfter", (unsigned long long)readback, 32);
+    SYSLOG("atk", "Keyboard backlight level %d write ret 0x%x KBBN before 0x%x after 0x%x", keyboardBacklightLevel, ret, before, readback);
+}
+
+void AsusSMC::sweepKBBN() {
+    if (sweepValue > kKBMaxLevel) {
+        if (sweepTimer) {
+            sweepTimer->cancelTimeout();
+            if (workloop) workloop->removeEventSource(sweepTimer);
+            OSSafeReleaseNULL(sweepTimer);
+        }
+        return;
+    }
+
+    writeKBBN(kbLevelValue(sweepValue));
+    setProperty("SweepValue", (unsigned long long)sweepValue, 32);
+    sweepValue++;
+
+    if (sweepTimer) sweepTimer->setTimeoutMS(2000);
+}
+
+uint32_t AsusSMC::readECReg(const char *method) {
+    uint32_t value = 0xFFFFFFFF;
+    atkDevice->evaluateInteger(method, &value);
+    return value;
+}
+
+void AsusSMC::writeECReg(int id, uint8_t value) {
+    static const char *methods[] = {"SKBB", "SKBS", "SKSP", "SKMC", "SKL1", "SKL2", "SKL3", "SKBC", "SKBA", "SK5B"};
+    if (id < 0 || id > 9) return;
+    OSNumber *arg = OSNumber::withNumber(value, 8);
+    atkDevice->evaluateObject(methods[id], NULL, (OSObject **)&arg, 1);
+    arg->release();
 }
 
+void AsusSMC::writeECRam(uint8_t offset, uint8_t value) {
+    OSObject *args[2] = {OSNumber::withNumber(offset, 8), OSNumber::withNumber(value, 8)};
+    atkDevice->evaluateObject("EWRB", NULL, args, 2);
+    args[0]->release();
+    args[1]->release();
+}
+
+uint32_t AsusSMC::readECRam(uint8_t offset) {
+    uint32_t value = 0xFFFFFFFF;
+    OSNumber *arg = OSNumber::withNumber(offset, 8);
+    atkDevice->evaluateInteger("ERDB", &value, (OSObject **)&arg, 1);
+    arg->release();
+    return value;
+}
+
+void AsusSMC::readECRegisters() {
+    setProperty("EKBBN", (unsigned long long)readECReg("GKBB"), 32);
+    setProperty("EKBBS", (unsigned long long)readECReg("GKBS"), 32);
+    setProperty("EKBSP", (unsigned long long)readECReg("GKSP"), 32);
+    setProperty("EKBMC", (unsigned long long)readECReg("GKMC"), 32);
+    setProperty("EKL1", (unsigned long long)readECReg("GKL1"), 32);
+    setProperty("EKL2", (unsigned long long)readECReg("GKL2"), 32);
+    setProperty("EKL3", (unsigned long long)readECReg("GKL3"), 32);
+    setProperty("EKLM", (unsigned long long)readECReg("GKLM"), 32);
+    setProperty("EKLT", (unsigned long long)readECReg("GKLT"), 32);
+    setProperty("EKBF", (unsigned long long)readECReg("GKBF"), 32);
+    setProperty("EKBLC", (unsigned long long)readECReg("GKBC"), 32);
+    setProperty("EKBLA", (unsigned long long)readECReg("GKBA"), 32);
+    setProperty("EKB5B", (unsigned long long)readECReg("GK5B"), 32);
+}
+
+void AsusSMC::runKBTest() {
+    struct KBTestStep { int reg1; uint8_t val1; int reg2; uint8_t val2; };
+    static const KBTestStep steps[] = {
+        {0, 0x81, -1, 0}, {0, 0x82, -1, 0}, {0, 0x83, -1, 0},
+        {10, 0x3F, -1, 3}, {10, 0x2E, -1, 3}, {10, 0x2E, -1, 1}, {10, 0x2E, -1, 2},
+        {10, 0xA5, -1, 0x83}, {10, 0xA5, -1, 0x03},
+        {10, 0x22, -1, 0xFF}, {10, 0x2F, -1, 1},
+        {10, 0x3F, -1, 0}, {10, 0x2E, -1, 0},
+    };
+    static const int stepCount = sizeof(steps) / sizeof(steps[0]);
+
+    if (kbTestIndex >= stepCount) {
+        setProperty("TestDone", kOSBooleanTrue);
+        return;
+    }
+
+    const KBTestStep &step = steps[kbTestIndex];
+    if (step.reg1 == 10) writeECRam(step.val1, step.val2);
+    else writeECReg(step.reg1, step.val1);
+    if (step.reg2 >= 0) writeECReg(step.reg2, step.val2);
+
+    setProperty("TestIndex", (unsigned long long)kbTestIndex, 32);
+    setProperty("TestReg1", (unsigned long long)step.reg1, 32);
+    setProperty("TestVal1", (unsigned long long)step.val1, 32);
+    setProperty("TestReg2", (unsigned long long)step.reg2, 32);
+    setProperty("TestVal2", (unsigned long long)step.val2, 32);
+    readECRegisters();
+    setProperty("ERD3F", (unsigned long long)readECRam(0x3F), 32);
+    setProperty("ERD2E", (unsigned long long)readECRam(0x2E), 32);
+    setProperty("ERDA5", (unsigned long long)readECRam(0xA5), 32);
+
+    kbTestIndex++;
+}
