+// MARK: - user client
+
+class AsusSMCUserClient : public IOUserClient {
+    OSDeclareDefaultStructors(AsusSMCUserClient)
+
+public:
+    bool initWithTask(task_t owningTask, void *securityToken, UInt32 type, OSDictionary *properties) override;
+    bool start(IOService *provider) override;
+    IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *arguments,
+                            IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) override;
+    IOReturn clientClose() override;
+
+private:
+    AsusSMC *asus {nullptr};
+};
+
+OSDefineMetaClassAndStructors(AsusSMCUserClient, IOUserClient)
+
+bool AsusSMCUserClient::initWithTask(task_t owningTask, void *securityToken, UInt32 type, OSDictionary *properties) {
+    return IOUserClient::initWithTask(owningTask, securityToken, type, properties);
+}
+
+bool AsusSMCUserClient::start(IOService *provider) {
+    if (!IOUserClient::start(provider)) {
+        return false;
+    }
+    asus = OSDynamicCast(AsusSMC, provider);
+    return asus != nullptr;
+}
+
+IOReturn AsusSMCUserClient::clientClose() {
+    asus = nullptr;
+    terminate();
+    return kIOReturnSuccess;
+}
+
+IOReturn AsusSMCUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *arguments,
+                                           IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) {
+    if (!asus) {
+        return kIOReturnNotAttached;
+    }
+
+    switch (selector) {
+        case 0:
+            if (arguments->scalarInputCount < 1) {
+                return kIOReturnBadArgument;
+            }
+            return asus->setBacklightLevelUser((uint32_t)arguments->scalarInput[0]);
+        case 1:
+            if (arguments->scalarOutputCount < 1) {
+                return kIOReturnBadArgument;
+            }
+            arguments->scalarOutput[0] = asus->getBacklightLevelUser();
+            return kIOReturnSuccess;
+        default:
+            return kIOReturnUnsupported;
+    }
+}
+
+IOReturn AsusSMC::setBacklightLevelUser(uint32_t level) {
+    if (!hasKeyboardBacklight) {
+        return kIOReturnUnsupported;
+    }
+    if (level >= (uint32_t)kKBLevelCount) {
+        level = kKBLevelCount - 1;
+    }
+    keyboardBacklightLevel = (int)level;
+    return writeKBBN(kKBLevels[keyboardBacklightLevel]);
+}
+
+uint64_t AsusSMC::getBacklightLevelUser() {
+    return (uint64_t)keyboardBacklightLevel;
+}
