<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tiriba.asuskeys</string>
    <key>ProgramArguments</key>
    <array>
        <string>@HOME@/Applications/AsusKeys/asuskeysd</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>@HOME@/Library/Logs/asuskeysd.out</string>
    <key>StandardErrorPath</key>
    <string>@HOME@/Library/Logs/asuskeysd.err</string>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
